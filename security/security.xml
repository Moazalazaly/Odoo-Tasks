<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="module_category_accounting_internship" model="ir.module.category">
            <field name="name">Accounting Internship</field>
            <field name="sequence">30</field>
        </record>

        <!-- Sales Intern Group -->
        <record id="group_intern_sale" model="res.groups">
            <field name="name">Sales Intern</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <!-- Purchase Intern Group -->
        <record id="group_intern_purchase" model="res.groups">
            <field name="name">Purchase Intern</field>
            <field name="category_id" ref="base.module_category_inventory_purchase"/>
            <field name="implied_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
        </record>

        <!-- Inventory Intern Group -->
        <record id="group_intern_stock" model="res.groups">
            <field name="name">Inventory Intern</field>
            <field name="category_id" ref="base.module_category_inventory_inventory"/>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>


        <!-- Accounting Intern Group -->
        <record id="group_intern_account" model="res.groups">
            <field name="name">Accounting Intern</field>
            <field name="category_id" ref="internship_app.module_category_accounting_internship"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        </record>

        <!-- Record Rule -->
        <record id="rule_intern_purchase_write_own_only" model="ir.rule">
            <field name="name">Intern: Write Own RFQs Only</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="groups" eval="[(4, ref('internship_app.group_intern_purchase'))]"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_intern_sales_write_own_only" model="ir.rule">
            <field name="name">Intern: Write Own RFQs Only</field>
            <field name="model_id" ref="sale_management.model_sale_order"/>
            <field name="groups" eval="[(4, ref('internship_app.group_intern_sale'))]"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>


        <record id="rule_intern_stock_write_own_only" model="ir.rule">
            <field name="name">Intern: Write Own stock moves Only</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="groups" eval="[(4, ref('internship_app.group_intern_stock'))]"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

