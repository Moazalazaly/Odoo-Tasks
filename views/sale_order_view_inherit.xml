<odoo>

    <record id = "sale_order_form_view_inherit" model = "ir.ui.view">
        <field name = "name">sale_order_form_view_inherit</field>
        <field name = "model">sale.order</field>
        <field name = "inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">state not in ['draft', 'sent', 'sale','to_approve'] or not id or locked</attribute>
            </xpath>

            <xpath expr="//form/sheet" position="before">
                <field name="can_confirm" invisible="1"/>
            </xpath>

            <xpath expr="//button[@id='action_confirm']" position="after">
                <button name="action_confirm" id = "confirm_button_for_to_approve_state" data-hotkey="q" string="Confirm" type="object" invisible="not can_confirm and  state!='to_approve'"/>
            </xpath>


        </field>
    </record>
</odoo>